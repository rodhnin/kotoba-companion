# ─── Kotoba backend (api/.env) ───────────────────────────────────────────────
# Copy this file to `api/.env` and fill in the real values.
# The backend boots without LLM/voice keys (the UI/SSE come up) — only the real voice + agentic loop
# runs when they're filled in. Everything is OUTBOUND: your machine reaches ElevenLabs and the LLM,
# nothing reaches in (no tunnel required for the default local voice mode).

# ─── GETTING STARTED (required for voice + agent) ──────────────────────────────
# Two keys, 2 minutes:
# your OpenAI key (reasoning model gpt-5.6-luna, web search, emotion)
OPENAI_API_KEY=sk-...
# your ElevenLabs key (outbound STT/TTS, local voice mode)
ELEVENLABS_API_KEY=el_...

# Database & config (fine as-is; only change if you know what you're doing)
# where Kotoba stores memory, audit logs, saved settings
DATABASE_URL=sqlite:///./kotoba.db
# her personality, voice, expressions (unset is fine — the copy inside the package is the fallback)
SOUL_PATH=./soul/default.md

# ─── LLM PROVIDER ──────────────────────────────────────────────────────────────
# Kotoba defaults to OpenAI gpt-5.6-luna (a reasoning model that does web search + emotion extraction).
# To use xAI Grok (or any OpenAI-compatible LLM instead):
#   1. Uncomment KOTOBA_LLM_PROVIDER and set the provider name
#   2. Uncomment and set the matching API key (XAI_API_KEY for xai, OPENAI_API_KEY for openai already above)
#   3. Optionally override the base_url (most providers have a sensible default)
# Both env vars MUST be set for a provider switch to take effect — setting only the provider silently
# leaves her with no key at all: every turn returns the offline message, and doctor says so.

# KOTOBA_LLM_PROVIDER=openai          # openai (default) | xai
# XAI_API_KEY=xai-...                 # xAI Grok API key (read only when KOTOBA_LLM_PROVIDER=xai)
# KOTOBA_LLM_BASE_URL=https://api.x.ai/v1  # optional; most providers have a default

# Chat model for the agentic loop. Unset means gpt-5.6-luna WHATEVER the provider is, so switching to
# xAI here means setting this too — `kotoba setup` and the web panel pin it for you, .env does not.
# KOTOBA_MODEL=gpt-5.6-luna           # OpenAI: gpt-5.6-luna (reasoning, cheapest) — `kotoba setup` lists the rest
#                                      # xAI: grok-4.3, grok-4.5 or grok-4.6 — `kotoba setup` lists them

# Per-role model overrides. Empty = inherit via the fallback chain (work → code → research → utility → companion).
# Companion uses KOTOBA_MODEL above as the final fallback. Set these only to split models per task.
# KOTOBA_WORK_MODEL=
# KOTOBA_CODE_MODEL=
# KOTOBA_RESEARCH_MODEL=
# KOTOBA_UTILITY_MODEL=

# Reasoning effort for the companion voice turn (voice latency is critical — lower is snappier).
# Used only by reasoning models (OpenAI o1/o3/o4-* and gpt-5*, xAI grok-4*); others ignore it.
#   minimal | low (the default) | medium | high | xhigh, plus max on OpenAI  (higher = more thinking
#   before any words stream = more silence on a voice turn). A value this provider does not offer is
#   folded DOWN to the nearest one it does, so `minimal` becomes `low` and xAI turns `max` into `xhigh`.
#   off / empty = treat the model as non-reasoning (no reasoning kwargs sent at all)
# It also decides WHO narrates tool use out loud. At any effort she narrates in her own words, in your
# language; at `off` she speaks short written lines instead, and those are English whatever language
# you are in. `kotoba doctor` reports the value that is actually being spent.
# KOTOBA_REASONING_EFFORT=low

# Reasoning effort for work mode (background, no voice latency to protect, deeper reasoning is OK).
# Unset → 'medium'. Set it to `off` to inherit the companion effort instead.
# KOTOBA_WORK_REASONING_EFFORT=medium

# Reasoning state storage. Leave unset (default: stateless, encrypted reasoning re-fed each turn — private).
# Set to true only if your model rejects encrypted reasoning (some older/non-OpenAI models do).
# KOTOBA_LLM_STORE=false

# ─── VOICE (OUTBOUND, NO TUNNEL NEEDED) ────────────────────────────────────────
# The LOCAL voice mode (default) has the browser WebSocket directly to your backend, and your backend
# talks to ElevenLabs — completely outbound, no public URL needed. The AGENT voice mode delegates
# everything to ElevenLabs' Conversational-AI platform; their cloud must reach your /v1/chat/completions,
# so it needs a public URL (tunnel/hosting) and an agent created in their dashboard. Agent mode buys
# you ElevenLabs' turn-taking but costs setup complexity.

# Voice transport (also live-settable in Settings → Personality):
#   local = this backend talks to ElevenLabs directly (DEFAULT, easiest, no tunnel needed)
#   agent = ElevenLabs Conversational-AI (their cloud calls your /v1, needs public URL + dashboard setup)
# KOTOBA_VOICE_MODE=local

# Speech-to-text (LOCAL voice mode). Both are read at connect time — restart the backend to change them.
#
# Normally you do NOT need this: Settings → Personality → Language already pins transcription too.
# Leave both on `auto` (DEFAULT) and ElevenLabs detects each utterance, which is what `language: auto`
# in soul/default.md promises: talk to her in any language and she answers in it. The trade is that
# auto-detection guesses per utterance and confuses close neighbours on SHORT ones — Spanish heard as
# Portuguese, ambient noise labelled Chinese — and she then answers in the wrong language, because the
# transcript is all she gets. This variable is the override for when the two must differ (ISO 639-1/3).
# KOTOBA_STT_LANGUAGE=es

# ElevenLabs' own "ignore nearby conversations and ambient noise" filter. ON by default: an idle room
# used to commit its own noise, and every commit bought a full agentic turn. Turn it off only if she
# is missing quiet speech.
# KOTOBA_STT_FILTER_BACKGROUND=true

# TTS engine for the LOCAL voice mode (also live-settable in Settings → Personality):
#   expressive = eleven_v3 over REST (DEFAULT) — performs [audio tags] so voice sounds emotional
#                Costs ~1s more latency BEFORE the first sentence of a turn
#   fast       = eleven_flash_v2_5 over WebSocket — lowest latency, but tags are stripped (flat voice)
# KOTOBA_TTS_ENGINE=expressive

# Optional voice_settings for the expressive (eleven_v3) engine. Leave unset → ElevenLabs defaults.
# v3 only accepts certain values; if you set these, make sure they're valid (e.g. stability 0.0/0.5/1.0).
# KOTOBA_TTS_STABILITY=0.5            # 0.0 (creative) | 0.5 (natural, default) | 1.0 (robust)
# KOTOBA_TTS_SIMILARITY=0.8           # similarity_boost, typically 0.7–0.9
# KOTOBA_TTS_STYLE=0.0                # style exaggeration, typically 0.0–1.0

# Voice model to use for TTS (the companion's voice_id from soul/default.md frontmatter, or this env var).
# Leave unset to use the voice_id in soul/default.md (the recommended way).
# KOTOBA_VOICE_ID=

# Emotion tags in the prompt and stream output ([happily], [nervous], etc.).
# Set to false to disable them (they cost prompt + output tokens if TTS can't perform them).
# Leave unset (true) to keep them on — the voice sounds richer with emotion.
# KOTOBA_EXPRESSIVE=true

# ─── API AUTHENTICATION & NETWORK ─────────────────────────────────────────────
# ⚠️  WARNING: /api/* is OPEN by default. In production, set KOTOBA_WEB_PASSWORD.

# API password for the web interface (/api/*) and the frontend gate.
# When set, EVERY /api/* route requires this token (Bearer header or ?token= for SSE/downloads).
# Also required in .env.local (SAME value, SAME name on both sides). Set KOTOBA_GATE_PASSWORD to the
# same value for backward compatibility, or use KOTOBA_WEB_PASSWORD (preferred — this name always wins
# if both are set). Leave UNSET for local dev (then /api/* is open and you don't need a password on the frontend).
# ⚠️  Production: always set this. Local dev: leave unset for a fresh clone to just work.
# KOTOBA_WEB_PASSWORD=your-secret-word

# Legacy alias for KOTOBA_WEB_PASSWORD (for backward compatibility). Used only when KOTOBA_WEB_PASSWORD
# is unset. Both sides (api/.env and .env.local) accept this name.
# KOTOBA_GATE_PASSWORD=

# Signs the browser's session cookie; defaults to the password above. BOTH sides read it, so setting it
# in only one of the two env files gives you two gates signing with different keys — the login succeeds
# and every request after it refuses, with nothing on screen to say why. Set it in both, or in neither.
# KOTOBA_GATE_SECRET=

# ⚠️  WARNING: /v1/chat/completions (ElevenLabs Conversational-AI custom LLM endpoint) is OPEN by default.
# Set this ONLY if you're using KOTOBA_VOICE_MODE=agent. It gates /v1 alone; it does NOT open /api/*.
# Pick ANY strong random secret (doesn't have to match KOTOBA_WEB_PASSWORD). ElevenLabs sends this as
# a Bearer token, so it must match what you set in the ElevenLabs dashboard for the Custom LLM API Key.
# KOTOBA_API_KEY=pick-a-long-random-secret-for-elevenlabs

# Master key for encrypting in-app-saved credentials (provider keys, MCP tokens) AT REST.
# When unset: an auto key is generated at ~/.kotoba/.keystore_key (fine for local installs).
# For containers with an EPHEMERAL filesystem (Cloud Run, Vercel, etc.): SET this from your secret manager.
# Otherwise a redeploy loses the auto keyfile and previously-saved in-app keys can't be decrypted (they
# silently fall back to env vars). For a persistent local install, leaving it unset is fine.
# KOTOBA_MASTER_KEY=a-long-random-secret

# Keystore key file path (where the auto-generated master key is stored). Unset → ~/.kotoba/.keystore_key.
# Only override this if you need the key in a non-standard location (rare). Most deployments leave this unset.
# KOTOBA_KEYSTORE_KEY_FILE=~/.kotoba/.keystore_key

# CORS origins for cross-origin API calls (e.g. a frontend on Vercel calling a Railway backend).
# Comma-separated, no spaces. http://localhost:3000 and http://127.0.0.1:3000 are ALWAYS allowed
# (local-first — a fresh clone just works). This env var ADDS origins on top of those defaults; it
# never replaces them. (In the local same-origin proxy mode, CORS doesn't matter — the browser never
# makes a cross-origin call.)
# CORS_ORIGINS=https://my-frontend.vercel.app

# Public base URL the backend is reachable at from the open internet.
# REQUIRED only if you use OAuth-based MCP servers (Notion, etc.), since it builds the OAuth callback URI:
#   <KOTOBA_PUBLIC_URL>/api/mcp/oauth/callback
# Use your Cloudflare tunnel, ngrok, Railway URL, or real domain. Must be HTTPS in production.
# Leave unset for local/same-origin deployments (the frontend proxies /api so no external URL is needed).
# KOTOBA_PUBLIC_URL=https://kotoba.example.com

# ─── EXECUTION SANDBOX ─────────────────────────────────────────────────────────
# ⚠️  WARNING: KOTOBA_SANDBOX defaults to 'local'. The agent runs shell/Python ON YOUR MACHINE,
#     Her FILE TOOLS are jailed to the library; a command you approve is not — it runs as you do.
#     Every non-trivial command asks first. This is intentional — she's YOUR agent.
#     You approve each step (or whitelist families like npm/git for blanket permission).
#     If you prefer isolated execution, set KOTOBA_SANDBOX=docker (needs Docker running).

# Execution backend for shell/code tools:
#   local  = run on THIS machine (DEFAULT) — child process in a jailed working dir, scrubbed env
#            (no API keys leak to the code), timeouts. No container. It's YOUR machine + YOUR agent.
#   docker = local Docker daemon (opt-in) — network-off, filesystem read-only except the workdir.
#            Needs Docker running. Files persist on the host (workdir bind-mounted).
#   none   = no tool of hers starts a process here: shell/code are not offered and file search
#            falls back to a literal-match walk. Web search, memory, files still work — and an
#            MCP server or the browser, installed and approved separately, still launches.
KOTOBA_SANDBOX=local

# Optional Docker image for the 'docker' sandbox backend (overrides the default python:3.12-slim).
# KOTOBA_SANDBOX_IMAGE=python:3.12-slim

# ─── BROWSER & MCP SERVERS ────────────────────────────────────────────────────
# The browser is a real Chromium-family browser (Brave → Chromium → Chrome → Edge) that Kotoba
# drives via @playwright/mcp. It launches one (with --remote-debugging-port) the first time she
# actually uses the browser — not at startup, and not on entering work mode — unless you point it at an
# existing browser's CDP endpoint. Using a real, logged-in browser avoids anti-bot walls that block
# headless/fresh instances.

# Browser's Chrome DevTools Protocol endpoint. Unset → she uses a headless browser of her own.
# Set it to point at a REAL browser (logged into sites you visit) for better success on anti-bot pages.
# To start a browser manually:
#   Brave:  brave --remote-debugging-port=9222 --user-data-dir=$TMPDIR/brave-debug
#   Chrome: google-chrome --remote-debugging-port=9222 --user-data-dir=$TMPDIR/chrome-debug
# KOTOBA_BROWSER_CDP=http://127.0.0.1:9222

# Browser executable path (auto-detected if unset). Set only to force a specific browser binary.
# KOTOBA_BROWSER_EXECUTABLE=/usr/bin/brave

# Directory where the auto-launched browser stores its profile (cache, cookies, history).
# Unset → ~/.kotoba/browser-profile. Useful to isolate the Kotoba browser from your everyday one.
# KOTOBA_BROWSER_PROFILE=~/.kotoba/browser-profile

# Browser output directory for saved screenshots (the tool saves them here as backup; the Files
# panel shows them too). Unset → ~/.kotoba/playwright-output.
# KOTOBA_BROWSER_OUTPUT_DIR=~/.kotoba/playwright-output

# Browser TOOL denylist — comma-separated fragments matched against the browser TOOL NAME, not against
# any URL. E.g. "evaluate, pdf" withholds browser__browser_evaluate and browser__browser_pdf_save.
# This CANNOT block a site: "facebook.com" matches no tool name and would silently do nothing.
# Unset → every browser tool is offered.
# KOTOBA_BROWSER_TOOL_DENY=

# MCP servers to activate on startup (comma-separated). Curated names: "filesystem", "github", "notion",
# "browser", etc. Leave unset, or ask Kotoba ("install the filesystem server") or use Settings → MCP servers.
# KOTOBA_MCP_ALWAYS_ACTIVE=browser

# MCP config file path (alternative to the default ~/.kotoba/mcp.yaml). The file is auto-created if needed.
# KOTOBA_MCP_CONFIG=~/.kotoba/mcp.yaml

# MCP server connection timeout in seconds (how long to wait for a server to start/respond).
# KOTOBA_MCP_CONNECT_TIMEOUT=30

# DISABLES the SSRF guard on REMOTE (url) MCP servers. Leave it unset: by default a server URL pointing
# at loopback, link-local or a private range is refused, because that URL can be model-influenced and
# would otherwise reach services on your own network. Set it to 1 ONLY to connect an MCP server you run
# yourself on localhost or the LAN — it does not affect stdio servers, which never carry a URL.
# KOTOBA_ALLOW_LOCAL_MCP=

# Fallback MCP registry discovery (1/true/yes to enable). When enabled, if the main registry search
# fails, try a fallback registry. Unset (true) to enable; set to 0/false to disable.
# KOTOBA_MCP_DISCOVERY_FALLBACK=1

# Where MCP servers that still need something wait (auto-created at ~/.kotoba/pending_mcp.yaml).
# Every server she found but could not finish — a missing token as well as an unfinished browser
# sign-in. It never stores a secret. Leave unset unless you're changing the path.
# KOTOBA_PENDING_MCP=~/.kotoba/pending_mcp.yaml

# ─── MCP SERVER CREDENTIALS ──────────────────────────────────────────────────
# API keys / tokens for MCP servers, read at startup. These are stored in the env, not encrypted.
# For production, store them in your secret manager and pass them at runtime (or use Settings to paste them).

# GitHub personal access token (or alias GITHUB_TOKEN for backward compat). Required if you connect the
# GitHub MCP server (for repo browsing, code search, etc.). The Settings panel can also accept this live.
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...

# ─── WORKSPACE & FILES ────────────────────────────────────────────────────────
# By default, Kotoba works in her file LIBRARY (~/.kotoba/files), mirrored by the Files panel.
# In advanced mode, point her at a REAL project folder (repo, doc folder, etc.) and she works there instead.
# Her file tools are jailed to that folder (or the library), and so is the gate's decision to let a
# read pass unasked. A command you approve runs with your own permissions and is not confined.

# Working directory for shell/code (advanced mode). Leave unset to use the file library (default).
# When set: Kotoba works in THIS folder instead of the library. Useful for pointing her at a real repo
# or project folder. Files in this folder can persist and sync with your own edits.
# KOTOBA_WORKSPACE_DIR=/home/you/my-project

# File library directory where Kotoba saves files she creates/edits (the Files panel reads this).
# Unset → ~/.kotoba/files. Text capped ~200 KB per file, images ~12 MB. Nothing is deleted on a file
# count here: the newest-500 cap applies only when KOTOBA_WORKSPACE_DIR points elsewhere and this
# folder is a mirror of copies.
# On persistent storage (not ephemeral), mount this as a volume so files survive redeploys.
# KOTOBA_FILES_DIR=~/.kotoba/files

# Where installed Live2D models live, one folder per model. Unset → ~/.kotoba/models. Read-only:
# Kotoba serves these files to the browser and never writes here. No model ships with Kotoba (they
# cannot be redistributed), so this folder is empty until you unpack one into it — see docs/self-hosting.md.
# On persistent storage, mount it as a volume, or her face is gone after a redeploy.
# KOTOBA_MODELS_DIR=~/.kotoba/models

# Temporary directory for throwaway files (scripts, downloads during web scraping, etc.).
# Exposed as $TMPDIR inside shell/code execution. Unset → ~/.kotoba/tmp.
# KOTOBA_TMP_DIR=~/.kotoba/tmp

# (Display-only, not yet enforced) trust tier shown in the Settings panel. Reserves a feature-flag for
# future access-level enforcement (e.g. different limits for 'guest' vs 'owner' trust). Leave unset.
# KOTOBA_TRUST=workspace

# ─── MEMORY & PLUGINS ─────────────────────────────────────────────────────────
# Kotoba keeps persistent memory of conversations (USER.md) and visual memories (screenshots, keepsakes).
# Plugin system lets you drop custom tools in ~/.kotoba/plugins/.

# User memory directory (USER.md, session facts, etc.). Unset → ~/.kotoba/memory.
# KOTOBA_MEMORY_DIR=~/.kotoba/memory

# Visual memory directory (screenshots, keepsakes from remember_image). Unset → ~/.kotoba/visual-memory.
# KOTOBA_VISUAL_MEMORY_DIR=~/.kotoba/visual-memory

# Community plugin directory (drop .py modules here to auto-discover custom tools). Unset → ~/.kotoba/plugins/.
# KOTOBA_PLUGINS_PATH=~/.kotoba/plugins

# Skill docs directory (read-only; internal, usually not overridden).
# KOTOBA_SKILLS_DIR=

# Settings file (the Settings panel persists your choices here). Unset → ~/.kotoba/settings.yaml.
# KOTOBA_SETTINGS=~/.kotoba/settings.yaml

# ─── AGENTIC LOOP TUNING (IMPORT-TIME, SET BEFORE STARTUP) ───────────────────
# These limits are READ AT MODULE IMPORT TIME — changing them on a running server has NO EFFECT.
# Restart the backend to pick up a change. Use the Settings panel (runtime_value) for limits that
# can be changed live (work_timeout, work_max_iter, work_max_tool_calls, work_fail_limit, sandbox).

# Maximum iterations for work mode (think: "find the answer in 40 steps or give up").
# KOTOBA_WORK_MAX_ITER=40

# Maximum tool calls per companion turn (inline chat). Anti-loop safeguard.
# KOTOBA_MAX_TOOL_CALLS=8

# Maximum tool calls per work mode turn (background task, can be longer).
# KOTOBA_WORK_MAX_TOOL_CALLS=40

# Maximum consecutive tool failures before the work loop gives up.
# KOTOBA_WORK_FAIL_LIMIT=6

# Maximum consecutive tool failures in companion mode (inline voice).
# KOTOBA_FAIL_LIMIT=2

# Chromium refuses to start as root without this, which is the case inside a container. It turns the
# sandbox OFF for the headless render, so set it only where the container IS the sandbox.
# KOTOBA_CHROMIUM_NO_SANDBOX=1

# Maximum per-tool rate limit retries (when an API is rate-limiting you).
# KOTOBA_RATELIMIT_RETRIES=6

# Tool call limits (domain-specific, import-time tuning):
# calls to the same tool per turn
KOTOBA_PER_TOOL_LIMIT=3
# web searches per turn
KOTOBA_WEB_SEARCH_LIMIT=8
# delegate (ask another agent) calls per turn
KOTOBA_DELEGATE_LIMIT=3
# browser navigation steps per turn
KOTOBA_BROWSER_TOOL_LIMIT=40
# todo/task management operations per turn
KOTOBA_TODO_TOOL_LIMIT=10
# concurrent delegates running at once
KOTOBA_DELEGATE_CONCURRENCY=2

# URL lookback for citation tracking (how many recent user messages to scan for URLs to cite).
# KOTOBA_URL_LOOKBACK=3

# ─── ADVANCED TUNING ──────────────────────────────────────────────────────────
# Most of these are internal knobs. Leave them alone unless you know what you're doing.

# Tokens-per-minute floor (rate limit soft threshold). Kotoba backs off requests when TPM exceeds this.
# KOTOBA_TPM_FLOOR=35000

# Longest pacing wait Kotoba will take on its own reading of the rate-limit headers. A TPM bucket
# refills within a minute, so a reset further out than this is treated as a header worth ignoring.
# KOTOBA_TPM_MAX_PACE=75

# Longest server-supplied Retry-After Kotoba will actually sleep. Past this it is a daily quota
# rather than a rate window, and failing the turn beats stalling it.
# KOTOBA_MAX_RETRY_AFTER=120

# Maximum conversation history to send to the LLM (number of recent turns).
# KOTOBA_MAX_HISTORY=24

# Time zone name (IANA format, e.g. "America/New_York"). Used in time-aware prompts. Leave unset for UTC.
# KOTOBA_TZ=

# Logging level (DEBUG | INFO | WARNING | ERROR). Unset → INFO.
# KOTOBA_LOG_LEVEL=INFO

# Work mode timeout in seconds (wall-clock limit for a background task). Must be ≥ 30.
# Unset → 3600 (one hour), or 1500 when the job was launched from an ElevenLabs call, which cuts first.
# KOTOBA_WORK_TIMEOUT=3600

# Trap for the key-deletion safety mechanism (1/true = enabled, default; 0/false = disabled).
# When enabled, log a warning if something tries to delete a credential. Leave enabled.
# KOTOBA_KEY_DELETE_TRAP=1

# --- DISCORD (her third face - `kotoba discord`) ------------------------------
# Needs the extra: pip install -e "api/[discord]". Values here are read as written: this file is also
# loaded by docker compose, which does NOT strip a trailing comment, so never put one beside a value.

# The ONE Discord account that is HER PERSON, as a numeric user id. Never inferred from anything
# anyone types. UNSET (the default) means nobody is: she offers only the guest surface to everybody,
# refuses to attach a file from your library, and no card for a command on this machine can be
# approved by anyone - it times out denied.
# KOTOBA_DISCORD_OWNER_ID=

# Restrict her to these guild ids, comma-separated. Empty (the default) means every server she was
# invited to. `kotoba discord --guild <id>` (repeatable) overrides this for one run.
# KOTOBA_DISCORD_GUILDS=

# Channel ids where she answers EVERY message, not only the ones that name her. Comma-separated.
# Empty (the default): she answers a mention, a reply to something of hers, a DM, and a short window
# after she just spoke to the same person.
# KOTOBA_DISCORD_HOME_CHANNELS=

# The bot token. Prefer `kotoba discord --save-token`, which puts it in the encrypted keystore; the
# keystore is read first, and this variable is the escape hatch for a first run with no database yet.
# DISCORD_BOT_TOKEN=
